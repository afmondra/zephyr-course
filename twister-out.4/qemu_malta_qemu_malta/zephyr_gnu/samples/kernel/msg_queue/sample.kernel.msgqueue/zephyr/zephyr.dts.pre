/dts-v1/;

# 1 "/Users/bytelight/zephyr-course/zephyr/dts/common/skeleton.dtsi" 1 3 4
# 9 "/Users/bytelight/zephyr-course/zephyr/dts/common/skeleton.dtsi" 3 4
/ {
 #address-cells = <1>;
 #size-cells = <1>;

 chosen {};

 aliases {};
