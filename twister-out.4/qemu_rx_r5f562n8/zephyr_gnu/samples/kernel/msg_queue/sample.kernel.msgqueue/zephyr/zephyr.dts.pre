# 1 "/Users/bytelight/zephyr-course/zephyr/include/zephyr/dt-bindings/gpio/gpio.h" 1 3 4
# 11 "/Users/bytelight/zephyr-course/zephyr/boards/qemu/rx/qemu_rx.dts" 2

/ {
 model = "Renesas QEMU";
 compatible = "qemu,rx";

 chosen {
  zephyr,sram = &sram0;
  zephyr,flash = &code_flash;
  zephyr,console = &uart0;
  zephyr,shell-uart = &uart0;
 };

 aliases {
  serial0 = &uart0;
 };
};

&sci0 {
 status = "okay";

 uart0: uart {
  current-speed = <115200>;
  status = "okay";
 };
};

&xtal {
 clock-frequency = <(((12) * 1000) * 1000)>;
 mosel = <0>;
 #clock-cells = <0>;
 status = "okay";
};

&subclk {
 status = "okay";
};

&pll {
 div = <2>;
 mul = <15>;
 status = "okay";
};

&cmt {
 clock-frequency = <6000000>;
 status = "okay";
};
